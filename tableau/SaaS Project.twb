            <column-instance column='[window_days]' derivation='None' name='[none:window_days:ok]' pivot='key' type='ordinal' />
            <column caption='Retained' datatype='integer' name='[retained]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2103139364143105]' derivation='User' name='[usr:Calculation_2103139364143105:qk]' pivot='key' type='quantitative' />
            <column caption='Window Days' datatype='integer' name='[window_days]' role='measure' type='quantitative' />
          </datasource-dependencies>
