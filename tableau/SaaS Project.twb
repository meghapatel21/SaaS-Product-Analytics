      <aliases enabled='yes' />
      <column caption='Trial-to-Paid Conversion' datatype='real' default-format='p0.00%' name='[Calculation_0858489601908739]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [trial_converted] = &quot;true&quot; THEN 1 ELSE 0 END) / &#13;&#10;SUM(IF [has_trial_subscription] = &quot;true&quot; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Try' datatype='real' name='[Calculation_0858489603440644]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(INT([trial_converted])) / SUM(INT([has_trial_subscription]))' />
      </column>
      <column caption='Account Churn Rate' datatype='real' name='[Calculation_0858489608032262]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [churn_flag] = &quot;true&quot; THEN 1 ELSE 0 END) / COUNTD([account_id])' />
      </column>
      <column caption='Count(Account ID)' datatype='integer' name='[Calculation_1220502530232321]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Count([account_id])' />
      </column>
      <column caption='&gt;=1 Churn Event' datatype='real' name='[Calculation_2103139361665024]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [has_churn_event] = &quot;true&quot; THEN 1 ELSE 0 END) / COUNTD([account_id])' />
      </column>
      <column caption='Engagement Share by Channel' datatype='real' name='[Calculation_2775764186013698]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [engagement_segment] IN (&apos;Power Accounts&apos;,&apos;Engaged Accounts&apos;) &#13;&#10;    THEN 1 ELSE 0 END) / COUNTD([account_id])' />
      </column>
