    <worksheet name='Engagement Share by Channel'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='account_features' name='federated.08gda9w19m9aiu12iip601hdbuos' />
          </datasources>
          <datasource-dependencies datasource='federated.08gda9w19m9aiu12iip601hdbuos'>
            <column caption='Engagement Share by Channel' datatype='real' name='[Calculation_2775764186013698]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [engagement_segment] IN (&apos;Power Accounts&apos;,&apos;Engaged Accounts&apos;) &#13;&#10;    THEN 1 ELSE 0 END) / COUNTD([account_id])' />
            </column>
            <column caption='Account Id' datatype='string' name='[account_id]' role='dimension' type='nominal' />
            <column caption='Engagement Segment' datatype='string' name='[engagement_segment]' role='dimension' type='nominal' />
