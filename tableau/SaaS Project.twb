              <calculation class='tableau' formula='SUM(IF [window_days] = 30 AND [dimension] = &apos;overall&apos; THEN [retained] END) / &#13;&#10;SUM(IF [window_days] = 30 AND [dimension] = &apos;overall&apos; THEN [eligible] END)' />
